rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /subscribers/{token} {
      // الزائر يضيف اشتراكه فقط (التعديل ممنوع → يرجع permission-denied إذا كان موجوداً، وهذا عادي)
      allow create: if request.resource.data.keys().hasOnly(['created', 'platform', 'lang']);
      // القراءة والحذف للأدمن فقط
      allow read, delete: if request.auth != null
                          && request.auth.token.email == 'bajioussema@gmail.com';
    }
  }
}
